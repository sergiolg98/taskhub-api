# Copia este archivo a .env (git lo ignora) y cambia los valores. Solo para desarrollo: nunca subas un .env con secretos reales.
DB_USER=taskhub
DB_PASSWORD=taskhub
DB_ROOT_PASSWORD=root
# Solo para docker-compose.dev.yml (la base de datos publicada en el host)
DB_PORT=3306
# Secreto HMAC del JWT (texto plano, mínimo 32 caracteres). El MISMO para auth-service y task-service.
JWT_SECRET=cambia-este-secreto-de-desarrollo-por-uno-de-32-o-mas-caracteres
# Opcional
# IMAGE_TAG=latest
# JAVA_TOOL_OPTIONS=-Xmx256m
